{
	"name": "@just-web/os",
	"version": "9.0.1",
	"description": "just-web os plugin module",
	"keywords": [
		"just-web",
		"os",
		"framework"
	],
	"homepage": "https://github.com/justland/just-web/tree/main/plugins/os",
	"bugs": {
		"url": "https://github.com/justland/just-web/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/justland/just-web.git",
		"directory": "plugins/os"
	},
	"license": "MIT",
	"author": {
		"name": "Homa Wong (unional)",
		"email": "homawong@gmail.com",
		"url": "https://github.com/unional"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./esm/index.d.ts",
			"default": "./esm/index.mjs"
		},
		"./testing": {
			"types": "./esm/testing/index.d.ts",
			"default": "./esm/testing/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"module": "./esm/index.mjs",
	"types": "./esm/index.d.ts",
	"files": [
		"esm",
		"src",
		"!**/*.{spec,test,unit,accept,integrate,system,perf,stress}.*",
		"CHANGELOG.md"
	],
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"build": "run-s build:code build:types",
		"build:code": "tsdown --tsconfig tsconfig.build.json",
		"build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
		"clean": "rimraf cjs esm coverage tslib --glob *.tsbuildinfo",
		"coverage": "vitest run --coverage",
		"nuke": "rimraf node_modules",
		"size": "size-limit",
		"test": "vitest run",
		"test:watch": "vitest",
		"w": "pnpm test:watch",
		"verify": "npm-run-all -p build lint coverage -p size"
	},
	"dependencies": {
		"platform": "~1.3.6",
		"type-plus": "8.0.1"
	},
	"devDependencies": {
		"@just-web/app": "workspace:^",
		"@just-web/repo-scripts": "workspace:^",
		"@repobuddy/typescript": "^2.2.2",
		"@repobuddy/vitest": "catalog:",
		"@size-limit/preset-small-lib": "~13.1.0",
		"@types/platform": "~1.3.6",
		"@vitest/coverage-v8": "^5.0.3",
		"npm-run-all2": "^9.0.3",
		"repobuddy": "^2.2.0",
		"rimraf": "~6.1.3",
		"size-limit": "~13.1.0",
		"tsdown": "^0.22.14",
		"vitest": "^5.0.3"
	},
	"peerDependencies": {
		"@just-web/app": "workspace:^"
	}
}
